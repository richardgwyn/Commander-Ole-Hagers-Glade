[Unit]
Description=Commander protocol v4 multiplayer server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=duck
Group=duck
WorkingDirectory=/opt/commander-v4
EnvironmentFile=/etc/duck/server.env
ExecStart=/opt/commander-v4/.venv/bin/python -m duckserver
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=600M
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
